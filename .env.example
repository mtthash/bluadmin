# =============================================================================
# BluAdmin - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Database ---
POSTGRES_USER=bluadmin
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=bluadmin
DATABASE_URL=postgresql+asyncpg://bluadmin:change_me_to_a_strong_password@postgres:5432/bluadmin

# --- Azure AD / Entra ID ---
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-backend-app-client-id
AZURE_CLIENT_SECRET=your-backend-app-client-secret
AZURE_FRONTEND_CLIENT_ID=your-frontend-app-client-id

# --- Role Group Mapping (Azure AD Group Object IDs) ---
AZURE_GROUP_ID_HR=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_GROUP_ID_IT=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_GROUP_ID_ADMIN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- App ---
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Frontend (used by docker-compose for Vite env vars) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_AZURE_CLIENT_ID=your-frontend-app-client-id
VITE_AZURE_TENANT_ID=your-tenant-id-here
VITE_AZURE_BACKEND_CLIENT_ID=your-backend-app-client-id
VITE_REDIRECT_URI=http://localhost:3000
